{
	"name": "df_gold_fact_admisiones",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "srcAdmissions"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_diagnoses",
						"type": "DatasetReference"
					},
					"name": "srcDiagnoses"
				},
				{
					"dataset": {
						"referenceName": "ds_gold_dim_paciente",
						"type": "DatasetReference"
					},
					"name": "srcDimPaciente"
				},
				{
					"dataset": {
						"referenceName": "ds_gold_dim_departamento",
						"type": "DatasetReference"
					},
					"name": "srcDimDepartamento"
				},
				{
					"dataset": {
						"referenceName": "ds_gold_dim_diagnostico",
						"type": "DatasetReference"
					},
					"name": "srcDimDiagnostico"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_gold_fact_admisiones",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "ordenarDiag"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "calculos"
				},
				{
					"name": "lkPaciente"
				},
				{
					"name": "lkDepartamento"
				},
				{
					"name": "lkDiagPrincipal"
				},
				{
					"name": "llaveDiag"
				},
				{
					"name": "lkDiagnostico"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcAdmissions",
				"source(output(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcDiagnoses",
				"source(output(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcDimPaciente",
				"source(output(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcDimDepartamento",
				"source(output(",
				"          diagnostico_key as integer,",
				"          codigo_icd as string,",
				"          descripcion_patologia as string,",
				"          nivel_severidad as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcDimDiagnostico",
				"srcDiagnoses window(over(admission_id),",
				"     asc(diagnosis_id, true),",
				"     rn = rowNumber()) ~> ordenarDiag",
				"ordenarDiag filter(rn == 1) ~> filter1",
				"filter1 derive(d_admission_id = admission_id,",
				"          d_icd = icd_code,",
				"          d_sev = iif(isNull(severity),'Desconocido',severity)) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          d_admission_id,",
				"          d_icd,",
				"          d_sev",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"srcAdmissions derive(fecha_ingreso_key = toInteger(toString(admission_date,'yyyyMMdd')),",
				"          fecha_alta_key = iif(isNull(discharge_date), toInteger(null()), toInteger(toString(discharge_date,'yyyyMMdd'))),",
				"          dias_estancia = iif(",
				"    isNull(discharge_date),",
				"    toInteger(null()),",
				"    toInteger(",
				"        abs(",
				"            (",
				"                toTimestamp(",
				"                    toString(discharge_date, 'yyyy-MM-dd') + ' 00:00:00',",
				"                    'yyyy-MM-dd HH:mm:ss'",
				"                )",
				"                -",
				"                toTimestamp(",
				"                    toString(admission_date, 'yyyy-MM-dd') + ' 00:00:00',",
				"                    'yyyy-MM-dd HH:mm:ss'",
				"                )",
				"            ) / days(1)",
				"        )",
				"    )",
				"),",
				"          conteo_admisiones = 1) ~> calculos",
				"calculos, srcDimPaciente lookup(patient_id == patient_id_bk,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkPaciente",
				"lkPaciente, srcDimDepartamento lookup(department == nombre_departamento,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkDepartamento",
				"lkDepartamento, select1 lookup(admission_id == d_admission_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkDiagPrincipal",
				"lkDiagPrincipal derive(k_icd = iif(isNull(d_icd),'N/A',d_icd),",
				"          k_sev = iif(isNull(d_sev),'Desconocido',d_sev)) ~> llaveDiag",
				"llaveDiag, srcDimDiagnostico lookup(k_icd == codigo_icd",
				"     && k_sev == nivel_severidad,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkDiagnostico",
				"lkDiagnostico select(mapColumn(",
				"          admission_id_bk = admission_id,",
				"          paciente_key,",
				"          departamento_key,",
				"          diagnostico_key,",
				"          fecha_ingreso_key,",
				"          fecha_alta_key,",
				"          medico_id = attending_doctor_id,",
				"          dias_estancia,",
				"          conteo_admisiones",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admision_key as long,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          diagnostico_key as integer,",
				"          fecha_ingreso_key as integer,",
				"          fecha_alta_key as integer,",
				"          medico_id as integer,",
				"          dias_estancia as integer,",
				"          conteo_admisiones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id_bk,",
				"          paciente_key,",
				"          departamento_key,",
				"          diagnostico_key,",
				"          fecha_ingreso_key,",
				"          fecha_alta_key,",
				"          medico_id,",
				"          dias_estancia,",
				"          conteo_admisiones",
				"     )) ~> sink1"
			]
		}
	}
}