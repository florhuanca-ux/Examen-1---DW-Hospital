{
	"name": "df_silver_diagnoses",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_diagnoses",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_diagnoses",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(diagnosis_id = toInteger(trim(diagnosis_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          first_code = trim(split(icd_code,',')[1]),",
				"          diagnosis_description = trim(diagnosis_description),",
				"          sev_key = lower(trim(severity))) ~> derivedColumn1",
				"derivedColumn1 derive(icd_key = upper(regexReplace(first_code,'[^A-Za-z0-9]',''))) ~> derivedColumn2",
				"derivedColumn2 derive(icd_code = iif(length(icd_key)>3, concat(substring(icd_key,1,3),'.',substring(icd_key,4,length(icd_key))), icd_key),",
				"          severity = case(sev_key=='mild','Mild', sev_key=='moderate','Moderate', sev_key=='severe','Severe', sev_key=='critical','Critical', toString(null()))) ~> derivedColumn3",
				"derivedColumn3 filter(!isNull(diagnosis_id) && !isNull(admission_id) && !isNull(icd_code)) ~> filter1",
				"filter1, source2 exists(derivedColumn1@admission_id == source2@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 aggregate(groupBy(diagnosis_id),",
				"     admission_id = first(admission_id),",
				"          icd_code = first(icd_code),",
				"          diagnosis_description = first(diagnosis_description),",
				"          severity = first(severity)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     )) ~> sink1"
			]
		}
	}
}